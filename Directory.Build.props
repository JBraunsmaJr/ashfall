<Project>
  <!-- Shared settings for every project in the repository. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NuGet advisories and resolution notices are reported, but must not break a build on their own. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1603;NU1608;NU1701;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <Company>Ashfall</Company>
    <Product>Ashfall</Product>
    <Copyright>Copyright (c) 2026 Jon Braunsma</Copyright>

    <!-- Set to true in a project to put it under the deterministic-simulation rules (see eng/BannedSymbols.Deterministic.txt). -->
    <AshfallDeterministic Condition="'$(AshfallDeterministic)' == ''">false</AshfallDeterministic>
  </PropertyGroup>
</Project>
