<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Vulkan 1.3 renderer on BRUTAL: device selection, swapchain, frames in flight, dynamic rendering and the lit quad pass. Knows nothing about windows or the simulation; it renders what it is given.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ahwoo.Brutal.Vulkan.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Precompiled with eng/compile-shaders.sh; resource names are Ashfall.Rendering.Shaders.<file>. -->
    <EmbeddedResource Include="Shaders\*.spv" LogicalName="Ashfall.Rendering.Shaders.%(Filename)%(Extension)" />
    <None Include="Shaders\*.slang" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ashfall.Rendering.Tests" />
  </ItemGroup>

</Project>
