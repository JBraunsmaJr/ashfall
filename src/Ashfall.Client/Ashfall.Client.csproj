<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>The game client: composition root for the session, renderer, audio and UI. M2: a playable skirmish against the scripted or idle AI, rendered by the Vulkan renderer through the UI layer.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputType>Exe</OutputType>
    <AssemblyName>ashfall</AssemblyName>
    <RootNamespace>Ashfall.Client</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ahwoo.Brutal.Core" />
    <PackageReference Include="Ahwoo.Brutal.Glfw" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ashfall.Session\Ashfall.Session.csproj" />
    <ProjectReference Include="..\Ashfall.Rendering\Ashfall.Rendering.csproj" />
    <ProjectReference Include="..\Ashfall.UI\Ashfall.UI.csproj" />
  </ItemGroup>

</Project>
