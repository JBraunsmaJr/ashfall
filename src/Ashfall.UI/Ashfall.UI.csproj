  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ashfall.Session\Ashfall.Session.csproj" />
    <ProjectReference Include="..\Ashfall.Rendering\Ashfall.Rendering.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ashfall.UI.Tests" />
  </ItemGroup>

</Project>
